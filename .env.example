# ==============================================================================
# GADGETPOINT.IT / SNAPMAKER U1 STUDIO - CONFIGURAZIONE VARIABILI D'AMBIENTE
# ==============================================================================
# Copia questo file in .env e compila con i tuoi valori reali.
# In produzione su Render / Railway, inserisci queste chiavi nella sezione "Environment Variables".

# ------------------------------------------------------------------------------
# 1. Configurazione Server Web & Rete
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=*

# URL pubblico del negozio (utilizzato per link nelle email e webhook)
APP_URL=https://gadgetpoint.it

# ------------------------------------------------------------------------------
# 2. Sicurezza Gestionale Amministrativo (/admin)
# ------------------------------------------------------------------------------
# Chiave / Password di sicurezza per accedere al pannello ordini e listino
ADMIN_PIN=L21dic82

# ------------------------------------------------------------------------------
# 3. PayPal REST API v2 (Pagamenti Online Clienti)
# ------------------------------------------------------------------------------
# Modalità: "live" per incassi reali, "sandbox" per test
PAYPAL_MODE=live

# Credenziali PayPal REST API (ottenibili da developer.paypal.com)
PAYPAL_CLIENT_ID=il_tuo_client_id_live
PAYPAL_CLIENT_SECRET=il_tuo_client_secret_live
# Alias alternativo supportato dal codice:
# PAYPAL_SECRET=il_tuo_client_secret_live

# Email del conto PayPal su cui accreditare i pagamenti
PAYPAL_PAYEE_EMAIL=antonello.lauretti@gmail.com

# ------------------------------------------------------------------------------
# 4. Notifiche Email Transazionali (Resend API)
# ------------------------------------------------------------------------------
# Chiave API Resend (ottenibile da resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Indirizzo email mittente verificato su Resend (es. con dominio proprio)
FROM_EMAIL=ordini@gadgetpoint.it
# Alias alternativo supportato dal codice:
# RESEND_FROM_EMAIL=ordini@gadgetpoint.it

# Email proprietario/amministratore che riceve gli alert dei nuovi ordini
STORE_OWNER_EMAIL=antonello.lauretti@gmail.com
# Alias alternativo supportato dal codice:
# ADMIN_EMAIL=antonello.lauretti@gmail.com

# ------------------------------------------------------------------------------
# 5. Database Supabase PostgreSQL (Opzionale per persistenza remota)
# ------------------------------------------------------------------------------
# Se non valorizzati, l'applicazione usa il database locale JSON (ecommerce/data/orders_db.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
